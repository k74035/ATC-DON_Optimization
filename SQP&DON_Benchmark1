@dataclass
class SolverSettings:
    rho_r: float = 5.0
    rho_y: float = 5.0
    rho_g: float = 5.0
    tol: float = 1e-3
    max_outer: int = 100
    inner_sweeps: int = 1
    sweep_order: str = "topdown"

    sqp_maxiter: int = 250
    sqp_ftol: float = 1e-12

    don_width: int = 32
    don_layers: int = 2
    don_activation: str = "tanh"
    don_epochs: int = 300
    don_lr: float = 1e-3
    don_check_every: int = 20
    don_inner_tol: float = 1e-4
    don_warm_start: bool = True

    init_scale: float = 0.25


def node_order(benchmark: RegularTreeATCBenchmark, order: str) -> List[int]:
    if order == "topdown":
        return list(range(benchmark.N))
    if order == "bottomup":
        return list(reversed(range(benchmark.N)))
    raise ValueError("sweep_order must be 'topdown' or 'bottomup'")


def build_don_models(
    benchmark: RegularTreeATCBenchmark,
    x_all: np.ndarray,
    y_local: np.ndarray,
    targets: np.ndarray,
    link_targets: np.ndarray,
    lambda_r: np.ndarray,
    lambda_y: np.ndarray,
    mu_g: np.ndarray,
    settings: SolverSettings,
    nn_seed: int,
) -> List[LocalDON]:
    models: List[LocalDON] = []
    for j in range(benchmark.N):
        context = benchmark.local_context(
            j,
            x_all,
            y_local,
            targets,
            link_targets,
            lambda_r,
            settings.rho_r,
            lambda_y,
            settings.rho_y,
            mu_g,
            settings.rho_g,
        )
        models.append(
            LocalDON(
                input_dim=context.size,
                output_dim=benchmark.node_decision_dim(j),
                width=settings.don_width,
                layers=settings.don_layers,
                activation=settings.don_activation,
                lower=benchmark.decision_bounds(j)[0],
                upper=benchmark.decision_bounds(j)[1],
                seed=nn_seed + 1009 * j,
            )
        )
    return models


def count_model_parameters(models: Sequence[nn.Module]) -> int:
    return int(sum(p.numel() for model in models for p in model.parameters()))


def solve_atc(
    benchmark: RegularTreeATCBenchmark,
    method: str,
    seed: int,
    nn_seed: int,
    settings: SolverSettings,
    reference: Optional[Dict] = None,
) -> Dict:
    method = method.upper()
    if method not in {"SQP", "DON"}:
        raise ValueError("method must be SQP or DON")

    if min(settings.rho_r, settings.rho_y, settings.rho_g, settings.tol,
           settings.don_inner_tol, settings.don_lr) <= 0:
        raise ValueError("Penalty coefficients, tolerances and learning rate must be positive")
    if min(settings.max_outer, settings.inner_sweeps, settings.don_epochs,
           settings.don_check_every, settings.sqp_maxiter) < 1:
        raise ValueError("Iteration budgets and check interval must be >= 1")
    x_all, y_local, targets, link_targets = benchmark.initial_state(
        seed, settings.init_scale
    )
    lambda_r = np.zeros(benchmark.config.N_edge, dtype=float)
    lambda_y = np.zeros(benchmark.config.N_edge, dtype=float)
    mu_g = np.zeros(benchmark.N, dtype=float)

    start = time.perf_counter()  # Include DON model construction.
    history = []
    models: Optional[List[LocalDON]] = None
    model_params = 0
    if method == "DON":
        models = build_don_models(
            benchmark,
            x_all,
            y_local,
            targets,
            link_targets,
            lambda_r,
            lambda_y,
            mu_g,
            settings,
            nn_seed,
        )
        model_params = count_model_parameters(models)

    total_local_iterations = 0
    total_evaluations = 0
    local_failures = 0
    converged = False
    last_stationarity = math.inf
    last_response_consistency = math.inf
    last_link_consistency = math.inf
    last_gviol = math.inf
    last_change = math.inf

    order = node_order(benchmark, settings.sweep_order)

    outer = 0
    for outer in range(1, settings.max_outer + 1):
        x_before = x_all.copy()
        y_before = y_local.copy()
        t_before = targets.copy()
        Y_before = link_targets.copy()
        max_local_stationarity = 0.0

        for _ in range(settings.inner_sweeps):
            for j in order:
                if method == "SQP":
                    z, info = solve_local_sqp(
                        benchmark,
                        j,
                        x_all,
                        y_local,
                        targets,
                        link_targets,
                        lambda_r,
                        settings.rho_r,
                        lambda_y,
                        settings.rho_y,
                        mu_g,
                        settings.rho_g,
                        settings.sqp_maxiter,
                        settings.sqp_ftol,
                        settings.don_inner_tol,
                    )
                else:
                    assert models is not None
                    if not settings.don_warm_start:
                        models[j].reset_to_initial()
                    z, info = solve_local_don(
                        benchmark,
                        j,
                        models[j],
                        x_all,
                        y_local,
                        targets,
                        link_targets,
                        lambda_r,
                        settings.rho_r,
                        lambda_y,
                        settings.rho_y,
                        mu_g,
                        settings.rho_g,
                        settings.don_epochs,
                        settings.don_lr,
                        settings.don_check_every,
                        settings.don_inner_tol,
                    )

                benchmark.set_decision(
                    j, z, x_all, y_local, targets, link_targets
                )
                total_local_iterations += int(info["iterations"])
                total_evaluations += int(info["evaluations"])
                max_local_stationarity = max(
                    max_local_stationarity, float(info["stationarity"])
                )
                if not info["success"]:
                    local_failures += 1

        # Residuals after a full ATC sweep.
        residual_r = benchmark.response_consistency_residuals(
            x_all, y_local, targets
        )
        residual_y = benchmark.link_consistency_residuals(y_local, link_targets)
        response_consistency = (
            float(np.max(np.abs(residual_r))) if residual_r.size else 0.0
        )
        link_consistency = (
            float(np.max(np.abs(residual_y))) if residual_y.size else 0.0
        )
        consistency = max(response_consistency, link_consistency)

        g_raw = np.array(
            [benchmark.inequality(x_all[j])[0] for j in range(benchmark.N)]
        )
        gviol = float(np.max(np.maximum(0.0, g_raw)))

        dx = float(np.max(np.abs(x_all - x_before)))
        dy = float(np.max(np.abs(y_local - y_before))) if y_local.size else 0.0
        dt = float(np.max(np.abs(targets - t_before))) if targets.size else 0.0
        dY = (
            float(np.max(np.abs(link_targets - Y_before)))
            if link_targets.size
            else 0.0
        )
        iterate_change = max(dx, dy, dt, dY)

        # AL multiplier updates for response, linking and physical inequality.
        if residual_r.size:
            lambda_r = lambda_r + settings.rho_r * residual_r
            lambda_y = lambda_y + settings.rho_y * residual_y
        mu_g = np.maximum(0.0, mu_g + settings.rho_g * g_raw)

        # Re-evaluate every block at the SAME primal state and updated multipliers.
        max_local_stationarity = 0.0
        for j in range(benchmark.N):
            z = benchmark.decision(j, x_all, y_local, targets, link_targets)
            _, grad = benchmark.local_loss_grad(
                j, z, x_all, y_local, targets, link_targets, lambda_r,
                settings.rho_r, lambda_y, settings.rho_y, mu_g, settings.rho_g)
            max_local_stationarity = max(max_local_stationarity,
                projected_grad_inf(z, grad, *benchmark.decision_bounds(j)))
            total_evaluations += 1
        complementarity = float(np.max(np.abs(mu_g*g_raw)))
        history.append(dict(outer=outer, consistency=consistency, gviol=gviol,
            stationarity=max_local_stationarity, complementarity=complementarity,
            elapsed=time.perf_counter()-start))
        last_stationarity = max_local_stationarity
        last_response_consistency = response_consistency
        last_link_consistency = link_consistency
        last_gviol = gviol
        last_change = iterate_change

        if max(consistency, gviol, max_local_stationarity, complementarity, iterate_change) <= settings.tol:
            converged = True
            break

    elapsed = time.perf_counter() - start

    J, _, _, root_response = benchmark.global_objective(x_all, link_targets)
    r_explicit = benchmark.responses(x_all, y_local, targets)
    residual_r = benchmark.response_consistency_residuals(x_all, y_local, targets)
    residual_y = benchmark.link_consistency_residuals(y_local, link_targets)
    response_consistency = (
        float(np.max(np.abs(residual_r))) if residual_r.size else 0.0
    )
    link_consistency = (
        float(np.max(np.abs(residual_y))) if residual_y.size else 0.0
    )
    consistency = max(response_consistency, link_consistency)
    gviol = float(np.max(benchmark.constraint_violations(x_all)))
    J_decomp = benchmark.decomposed_objective(x_all, y_local, targets)

    result: Dict = {
        "method": f"ATC-{method}",
        "success": bool(converged),
        "converged": bool(converged),
        "local_failures": int(local_failures),
        "history": history,
        "complementarity": complementarity,
        "seed": int(seed),
        "nn_seed": int(nn_seed) if method == "DON" else -1,
        "objective": float(J),
        "objective_per_node": float(J / benchmark.N),
        "decomposed_objective": float(J_decomp),
        "objective_consistency_gap": float(abs(J - J_decomp)),
        "root_response": float(root_response),
        "explicit_root_response": float(r_explicit[0]),
        "system_target_error": float(abs(root_response - benchmark.config.system_target)),
        "response_consistency": response_consistency,
        "link_consistency": link_consistency,
        "consistency": consistency,
        "constraint_violation": gviol,
        "stationarity": float(last_stationarity),
        "iterate_change": float(last_change),
        "outer_iterations": int(outer),
        "local_iterations": int(total_local_iterations),
        "evaluations": int(total_evaluations),
        "time": float(elapsed),
        "model_parameters": int(model_params),
        "x": x_all.copy(),
        "y_local": y_local.copy(),
        "response_targets": targets.copy(),
        "link_targets": link_targets.copy(),
        "lambda_r": lambda_r.copy(),
        "lambda_y": lambda_y.copy(),
        "mu_g": mu_g.copy(),
    }

    if reference is not None and reference.get("success", False):
        ref_x = np.asarray(reference["x"], dtype=float)
        ref_Y = np.asarray(reference["link_targets"], dtype=float)
        result["objective_error"] = float(abs(J - float(reference["objective"])))
        result["objective_per_node_error"] = float(
            abs(J / benchmark.N - float(reference["objective"]) / benchmark.N)
        )
        result["x_error_inf"] = float(np.max(np.abs(x_all - ref_x)))
        result["link_error_inf"] = (
            float(np.max(np.abs(link_targets - ref_Y))) if ref_Y.size else 0.0
        )
        result["root_response_error_vs_ref"] = float(
            abs(root_response - float(reference["root_response"]))
        )
    else:
        result["objective_error"] = math.nan
        result["objective_per_node_error"] = math.nan
        result["x_error_inf"] = math.nan
        result["link_error_inf"] = math.nan
        result["root_response_error_vs_ref"] = math.nan

    return result


