KAPPA_CLASSES = ("Q2", "Q4", "Q6", "EXP")


# ============================================================================
# Benchmark scalar functions
# ============================================================================


def phi_np(x: np.ndarray, kappa: str) -> Tuple[np.ndarray, np.ndarray]:
    """Return phi_kappa(x) and its elementwise derivative."""
    x = np.asarray(x, dtype=float)
    if kappa == "Q2":
        return x**2, 2.0 * x
    if kappa == "Q4":
        return x**4, 4.0 * x**3
    if kappa == "Q6":
        return x**6, 6.0 * x**5
    if kappa == "EXP":
        den = math.e - 1.0
        ex = np.exp(x**2)
        return (ex - 1.0) / den, 2.0 * x * ex / den
    raise ValueError(f"Unsupported kappa={kappa!r}; choose from {KAPPA_CLASSES}")


def phi_torch(x: torch.Tensor, kappa: str) -> torch.Tensor:
    if kappa == "Q2":
        return x**2
    if kappa == "Q4":
        return x**4
    if kappa == "Q6":
        return x**6
    if kappa == "EXP":
        return (torch.exp(x**2) - 1.0) / (math.e - 1.0)
    raise ValueError(f"Unsupported kappa={kappa!r}")


# ============================================================================
# Configuration and regular B-ary ATC tree
# ============================================================================


@dataclass(frozen=True)
class BenchmarkConfig:
    # Local physical-design dimension and hierarchy geometry.
    m: int = 8
    B: int = 2
    D: int = 3

    # Local objective class.
    kappa: str = "Q2"

    # Response model / hierarchy aggregation.
    alpha: float = 0.5
    response_eta: float = 0.15

    # Fixed scalar linking-variable coupling.  This is deliberately NOT a main
    # case-study factor; n_y=1 for every sibling group.
    link_beta: float = 0.25

    # Physical inequality: b - mean(x_j) <= 0.
    b: float = 0.10

    # Root-level desired system response and weight.
    system_target: float = 0.75
    system_weight: float = 10.0

    # Common box bounds for physical designs, response targets and linking vars.
    lower: float = -2.0
    upper: float = 2.0

    def __post_init__(self) -> None:
        if self.m < 1:
            raise ValueError("m must be >= 1")
        if self.B < 1:
            raise ValueError("B must be >= 1")
        if self.D < 1:
            raise ValueError("D must be >= 1")
        if self.kappa not in KAPPA_CLASSES:
            raise ValueError(f"kappa must be one of {KAPPA_CLASSES}")
        if not (0.0 <= self.alpha <= 1.0):
            raise ValueError("alpha must be in [0,1]")
        if self.response_eta < 0.0:
            raise ValueError("response_eta must be >= 0")
        if self.link_beta < 0.0:
            raise ValueError("link_beta must be >= 0")
        # Keep x + eta*x^2 monotone over the configured x box.
        if 1.0 + 2.0 * self.response_eta * self.lower <= 0.0:
            raise ValueError(
                "response_eta is too large for the lower design bound; "
                "x + eta*x^2 must remain monotone on the box"
            )
        if not (self.lower < self.b < self.upper):
            raise ValueError("b must lie strictly inside the box bounds")
        if not (self.lower < self.system_target < self.upper):
            raise ValueError("system_target must lie inside the box bounds")
        if self.system_weight <= 0:
            raise ValueError("system_weight must be positive")

    @property
    def N_ATC(self) -> int:
        if self.B == 1:
            return self.D
        return (self.B**self.D - 1) // (self.B - 1)

    @property
    def N_edge(self) -> int:
        return max(0, self.N_ATC - 1)

    @property
    def N_internal(self) -> int:
        """Number of parents that own a shared child-linking target."""
        if self.D <= 1:
            return 0
        if self.B == 1:
            return self.D - 1
        return (self.B ** (self.D - 1) - 1) // (self.B - 1)

    @property
    def n_local_design_total(self) -> int:
        return self.N_ATC * self.m

    @property
    def n_design_total(self) -> int:
        """Independent physical variables: local x plus shared linking variables."""
        return self.n_local_design_total + self.N_internal

    @property
    def n_response_target_total(self) -> int:
        return self.N_edge

    @property
    def n_link_copy_total(self) -> int:
        # Every non-root element has one local copy y_j.
        return self.N_edge

    @property
    def n_link_target_total(self) -> int:
        # Every internal parent has one shared target Y_j for its children.
        return self.N_internal

    @property
    def n_decomposed_primal_total(self) -> int:
        return (
            self.n_local_design_total
            + self.n_response_target_total
            + self.n_link_copy_total
            + self.n_link_target_total
        )

    def short_label(self) -> str:
        return (
            f"m{self.m}_B{self.B}_D{self.D}_{self.kappa}_"
            f"a{self.alpha:g}_eta{self.response_eta:g}_"
            f"by{self.link_beta:g}_b{self.b:g}"
        )


class RegularTreeATCBenchmark:
    """Regular balanced B-ary ATC benchmark with response and linking coupling."""

    def __init__(self, config: BenchmarkConfig):
        self.config = config
        self.m = config.m
        self.B = config.B
        self.D = config.D
        self.N = config.N_ATC

        self.children: List[List[int]] = [[] for _ in range(self.N)]
        self.parent: List[Optional[int]] = [None for _ in range(self.N)]
        self.level = np.zeros(self.N, dtype=int)

        # Heap-like indexing for a complete regular B-ary tree.
        for j in range(self.N):
            for q in range(self.B):
                child = self.B * j + q + 1
                if child < self.N:
                    self.children[j].append(child)
                    self.parent[child] = j
                    self.level[child] = self.level[j] + 1

        self.edges: List[Tuple[int, int]] = []
        self.edge_of_child: List[Optional[int]] = [None] * self.N
        self.out_edges: List[List[int]] = [[] for _ in range(self.N)]
        for p in range(self.N):
            for c in self.children[p]:
                e = len(self.edges)
                self.edges.append((p, c))
                self.edge_of_child[c] = e
                self.out_edges[p].append(e)
        if len(self.edges) != config.N_edge:
            raise RuntimeError("Tree construction error")

        # One physical/shared scalar linking variable for every internal parent.
        self.internal_nodes = [j for j in range(self.N) if self.children[j]]
        self.link_target_index_of_parent: Dict[int, int] = {
            p: q for q, p in enumerate(self.internal_nodes)
        }
        if len(self.internal_nodes) != config.N_internal:
            raise RuntimeError("Internal-node count mismatch")

        # Deterministic within-node physical-design response weights.
        # For m=4: [1.00, 1.25, 1.50, 1.75] before normalization.
        self.response_weights = 1.0 + np.arange(self.m, dtype=float) / self.m
        self.response_weight_sum = float(np.sum(self.response_weights))

        # Structural coefficient s_j such that
        # R_root^AIO = sum_j s_j*q_j for any q_j values.
        self.root_response_weights = self._compute_root_response_weights()

    # ------------------------------------------------------------------ tree

    def _compute_root_response_weights(self) -> np.ndarray:
        cfg = self.config
        path = np.zeros(self.N, dtype=float)
        path[0] = 1.0
        weight = np.zeros(self.N, dtype=float)
        for j in range(self.N):
            kids = self.children[j]
            if kids:
                weight[j] += path[j] * cfg.alpha
                share = path[j] * (1.0 - cfg.alpha) / len(kids)
                for c in kids:
                    path[c] += share
            else:
                weight[j] += path[j]
        if not np.isclose(np.sum(weight), 1.0, atol=1e-12):
            raise RuntimeError(f"Response weights do not sum to 1: {weight.sum()}")
        return weight

    def _layout(self, j: int) -> Tuple[Optional[int], slice, Optional[int], int]:
        """Decision layout z_j=[x_j, y_j?, response_targets..., Y_j?]."""
        idx = self.m
        y_in_idx: Optional[int] = None
        if j != 0:
            y_in_idx = idx
            idx += 1
        nchild = len(self.children[j])
        t_slice = slice(idx, idx + nchild)
        idx += nchild
        y_out_idx: Optional[int] = None
        if nchild:
            y_out_idx = idx
            idx += 1
        return y_in_idx, t_slice, y_out_idx, idx

    def decision_bounds(self, j):
        """Physical x/y bounds and conservative, model-derived response bounds."""
        cfg = self.config
        lo = np.full(self.node_decision_dim(j), cfg.lower)
        hi = np.full(self.node_decision_dim(j), cfg.upper)
        _, ts, _, _ = self._layout(j)
        # q is monotone on the physical box; aggregation is a convex combination.
        # Including zero covers the root's absent incoming linking variable.
        lo[ts] = cfg.lower + cfg.response_eta*cfg.lower**2 + min(0., cfg.link_beta*cfg.lower)
        hi[ts] = cfg.upper + cfg.response_eta*cfg.upper**2 + max(0., cfg.link_beta*cfg.upper)
        return lo, hi

    def node_decision_dim(self, j: int) -> int:
        return self._layout(j)[3]

    def decision(
        self,
        j: int,
        x_all: np.ndarray,
        y_local: np.ndarray,
        targets: np.ndarray,
        link_targets: np.ndarray,
    ) -> np.ndarray:
        y_in_idx, t_slice, y_out_idx, dim = self._layout(j)
        z = np.empty(dim, dtype=float)
        z[: self.m] = x_all[j]
        if y_in_idx is not None:
            z[y_in_idx] = y_local[j]
        if self.children[j]:
            z[t_slice] = targets[self.out_edges[j]]
            assert y_out_idx is not None
            z[y_out_idx] = link_targets[self.link_target_index_of_parent[j]]
        return z

    def set_decision(
        self,
        j: int,
        z: np.ndarray,
        x_all: np.ndarray,
        y_local: np.ndarray,
        targets: np.ndarray,
        link_targets: np.ndarray,
    ) -> None:
        z = np.asarray(z, dtype=float)
        y_in_idx, t_slice, y_out_idx, dim = self._layout(j)
        if z.size != dim:
            raise ValueError("local decision has wrong dimension")
        x_all[j] = z[: self.m]
        if y_in_idx is not None:
            y_local[j] = z[y_in_idx]
        if self.children[j]:
            targets[self.out_edges[j]] = z[t_slice]
            assert y_out_idx is not None
            link_targets[self.link_target_index_of_parent[j]] = z[y_out_idx]

    # ---------------------------------------------------------- response model

    def local_analysis(
        self, x_j: np.ndarray, y_j: float = 0.0
    ) -> Tuple[float, np.ndarray, float]:
        """Return q_j(x_j,y_j), dq/dx_j, dq/dy_j.

        q_j = sum_k w_k*(x_jk + eta*x_jk^2)/sum_k(w_k) + beta_y*y_j.
        """
        x_j = np.asarray(x_j, dtype=float)
        eta = self.config.response_eta
        q_terms = x_j + eta * x_j**2
        qx = float(np.dot(self.response_weights, q_terms) / self.response_weight_sum)
        dqdx = self.response_weights * (1.0 + 2.0 * eta * x_j) / self.response_weight_sum
        q = qx + self.config.link_beta * float(y_j)
        dqdy = self.config.link_beta
        return float(q), np.asarray(dqdx, dtype=float), float(dqdy)

    def local_analysis_torch(self, x_j: torch.Tensor, y_j: torch.Tensor) -> torch.Tensor:
        weights = torch.as_tensor(
            self.response_weights, dtype=x_j.dtype, device=x_j.device
        )
        eta = self.config.response_eta
        qx = torch.sum(weights * (x_j + eta * x_j**2)) / self.response_weight_sum
        return qx + self.config.link_beta * y_j

    def _parts_from_z(
        self, j: int, z: np.ndarray
    ) -> Tuple[np.ndarray, float, np.ndarray, Optional[float]]:
        z = np.asarray(z, dtype=float)
        y_in_idx, t_slice, y_out_idx, dim = self._layout(j)
        if z.size != dim:
            raise ValueError("local decision has wrong dimension")
        x = z[: self.m]
        y_in = 0.0 if y_in_idx is None else float(z[y_in_idx])
        t_out = np.asarray(z[t_slice], dtype=float)
        y_out = None if y_out_idx is None else float(z[y_out_idx])
        return x, y_in, t_out, y_out

    def node_response_from_parts(
        self, x_j: np.ndarray, y_j: float, child_targets: np.ndarray
    ) -> float:
        q, _, _ = self.local_analysis(x_j, y_j)
        if child_targets.size == 0:
            return q
        a = self.config.alpha
        return float(a * q + (1.0 - a) * np.mean(child_targets))

    def node_response_from_z(self, j: int, z: np.ndarray) -> float:
        x, y_in, t_out, _ = self._parts_from_z(j, z)
        return self.node_response_from_parts(x, y_in, t_out)

    def node_response_grad(self, j: int, z: np.ndarray) -> np.ndarray:
        """Gradient dR_j/dz_j for explicit decomposed response."""
        x, y_in, t_out, _ = self._parts_from_z(j, z)
        _, dqdx, dqdy = self.local_analysis(x, y_in)
        y_in_idx, t_slice, _, dim = self._layout(j)
        grad = np.zeros(dim, dtype=float)
        if len(self.children[j]) == 0:
            scale = 1.0
        else:
            scale = self.config.alpha
        grad[: self.m] = scale * dqdx
        if y_in_idx is not None:
            grad[y_in_idx] = scale * dqdy
        if len(self.children[j]):
            grad[t_slice] = (1.0 - self.config.alpha) / len(self.children[j])
        return grad

    def responses(
        self, x_all: np.ndarray, y_local: np.ndarray, targets: np.ndarray
    ) -> np.ndarray:
        """Explicit ATC responses using local linking copies and outgoing targets."""
        r = np.zeros(self.N, dtype=float)
        for j in range(self.N):
            yj = 0.0 if j == 0 else float(y_local[j])
            child_targets = targets[self.out_edges[j]] if self.children[j] else np.empty(0)
            r[j] = self.node_response_from_parts(x_all[j], yj, child_targets)
        return r

    def physical_local_links(self, link_targets: np.ndarray) -> np.ndarray:
        """Map physical sibling-group linking variables to every element copy."""
        y = np.zeros(self.N, dtype=float)
        for child in range(1, self.N):
            p = self.parent[child]
            assert p is not None
            y[child] = link_targets[self.link_target_index_of_parent[p]]
        return y

    def true_responses(self, x_all: np.ndarray, link_targets: np.ndarray) -> np.ndarray:
        """AIO responses using one physical shared link variable per sibling group."""
        y_phys = self.physical_local_links(link_targets)
        r = np.zeros(self.N, dtype=float)
        for j in reversed(range(self.N)):
            q, _, _ = self.local_analysis(x_all[j], 0.0 if j == 0 else y_phys[j])
            kids = self.children[j]
            if kids:
                a = self.config.alpha
                r[j] = a * q + (1.0 - a) * float(np.mean(r[kids]))
            else:
                r[j] = q
        return r

    def consistent_targets(self, x_all: np.ndarray, link_targets: np.ndarray) -> np.ndarray:
        r_true = self.true_responses(x_all, link_targets)
        t = np.zeros(self.config.N_edge, dtype=float)
        for e, (_, c) in enumerate(self.edges):
            t[e] = r_true[c]
        return t

    def consistent_link_copies(self, link_targets: np.ndarray) -> np.ndarray:
        return self.physical_local_links(link_targets)

    def response_consistency_residuals(
        self, x_all: np.ndarray, y_local: np.ndarray, targets: np.ndarray
    ) -> np.ndarray:
        r = self.responses(x_all, y_local, targets)
        c = np.zeros(self.config.N_edge, dtype=float)
        for e, (_, child) in enumerate(self.edges):
            c[e] = targets[e] - r[child]
        return c

    def link_consistency_residuals(
        self, y_local: np.ndarray, link_targets: np.ndarray
    ) -> np.ndarray:
        c = np.zeros(self.config.N_edge, dtype=float)
        for e, (parent, child) in enumerate(self.edges):
            Y = link_targets[self.link_target_index_of_parent[parent]]
            c[e] = Y - y_local[child]
        return c

    # ------------------------------------------------------------- objectives

    def local_design_cost(self, x_j: np.ndarray) -> Tuple[float, np.ndarray]:
        val, grad = phi_np(x_j, self.config.kappa)
        return float(np.mean(val)), np.asarray(grad, dtype=float) / self.m

    def global_objective(
        self, x_all: np.ndarray, link_targets: np.ndarray
    ) -> Tuple[float, np.ndarray, np.ndarray, float]:
        """AIO objective, gradients wrt x and shared links, and root response."""
        cfg = self.config
        x_all = np.asarray(x_all, dtype=float).reshape(self.N, self.m)
        link_targets = np.asarray(link_targets, dtype=float).reshape(cfg.N_internal)

        J = 0.0
        grad_x = np.zeros_like(x_all)
        for j in range(self.N):
            fj, gj = self.local_design_cost(x_all[j])
            J += fj
            grad_x[j] += gj

        y_phys = self.physical_local_links(link_targets)
        q_all = np.zeros(self.N, dtype=float)
        dqdx_all = np.zeros_like(x_all)
        for j in range(self.N):
            q_all[j], dqdx_all[j], _ = self.local_analysis(
                x_all[j], 0.0 if j == 0 else y_phys[j]
            )

        r_root = float(np.dot(self.root_response_weights, q_all))
        mismatch = r_root - cfg.system_target
        J += cfg.system_weight * self.N * mismatch**2
        factor = 2.0 * cfg.system_weight * self.N * mismatch

        for j in range(self.N):
            grad_x[j] += factor * self.root_response_weights[j] * dqdx_all[j]

        grad_link = np.zeros(cfg.N_internal, dtype=float)
        for parent in self.internal_nodes:
            qidx = self.link_target_index_of_parent[parent]
            # The parent's shared Y affects q_c for every direct child c.
            dr_dY = cfg.link_beta * float(
                np.sum(self.root_response_weights[self.children[parent]])
            )
            grad_link[qidx] = factor * dr_dY

        return float(J), grad_x, grad_link, r_root

    def decomposed_objective(
        self, x_all: np.ndarray, y_local: np.ndarray, targets: np.ndarray
    ) -> float:
        """Objective in decomposed variables, excluding AL coordination terms."""
        total = sum(self.local_design_cost(x_all[j])[0] for j in range(self.N))
        r0 = self.responses(x_all, y_local, targets)[0]
        total += self.config.system_weight * self.N * (r0 - self.config.system_target) ** 2
        return float(total)

    # --------------------------------------------------------- physical g_j <= 0

    def inequality(self, x_j: np.ndarray) -> Tuple[float, np.ndarray]:
        """g_j=b-mean(x_j)<=0.  Linking variables are not part of g_j."""
        g = float(self.config.b - np.mean(x_j))
        dg = -np.ones(self.m, dtype=float) / self.m
        return g, dg

    def constraint_violations(self, x_all: np.ndarray) -> np.ndarray:
        return np.maximum(0.0, self.config.b - np.mean(x_all, axis=1))

    # ------------------------------------------------------------- local AL

    @staticmethod
    def phr_value_grad_scalar(g: float, mu: float, rho_g: float) -> Tuple[float, float]:
        """PHR inequality AL value and d(value)/dg for g<=0, mu>=0."""
        s = mu + rho_g * g
        pos = max(0.0, s)
        value = (pos**2 - mu**2) / (2.0 * rho_g)
        return float(value), float(pos)

    def local_loss_grad(
        self,
        j: int,
        z: np.ndarray,
        x_all: np.ndarray,
        y_local: np.ndarray,
        targets: np.ndarray,
        link_targets: np.ndarray,
        lambda_r: np.ndarray,
        rho_r: float,
        lambda_y: np.ndarray,
        rho_y: float,
        mu_g: np.ndarray,
        rho_g: float,
    ) -> Tuple[float, np.ndarray]:
        """Local augmented objective and analytic gradient wrt z_j."""
        cfg = self.config
        z = np.asarray(z, dtype=float)
        x_j, y_in, t_out, y_out = self._parts_from_z(j, z)
        y_in_idx, t_slice, y_out_idx, _ = self._layout(j)

        # Local physical design cost.
        loss, gx = self.local_design_cost(x_j)
        grad = np.zeros_like(z)
        grad[: self.m] += gx

        # Explicit node response and derivative wrt local decision block.
        r_j = self.node_response_from_parts(x_j, y_in, t_out)
        dr = self.node_response_grad(j, z)

        # Root system objective.
        if j == 0:
            mismatch = r_j - cfg.system_target
            loss += cfg.system_weight * self.N * mismatch**2
            grad += 2.0 * cfg.system_weight * self.N * mismatch * dr

        # Incoming response consistency: T_parent,j - R_j.
        e_in = self.edge_of_child[j]
        if e_in is not None:
            c_in = float(targets[e_in] - r_j)
            coeff = float(lambda_r[e_in] + rho_r * c_in)
            loss += float(lambda_r[e_in] * c_in + 0.5 * rho_r * c_in**2)
            grad += -coeff * dr

            # Incoming linking consistency: Y_parent - y_j.
            assert y_in_idx is not None
            p = self.parent[j]
            assert p is not None
            Y_parent = link_targets[self.link_target_index_of_parent[p]]
            cy_in = float(Y_parent - y_in)
            coeff_y = float(lambda_y[e_in] + rho_y * cy_in)
            loss += float(lambda_y[e_in] * cy_in + 0.5 * rho_y * cy_in**2)
            grad[y_in_idx] += -coeff_y

        # Outgoing response and linking consistencies controlled by parent j.
        if self.children[j]:
            current_r = self.responses(x_all, y_local, targets)
            assert y_out_idx is not None and y_out is not None
            for q, e in enumerate(self.out_edges[j]):
                _, child = self.edges[e]

                cr_out = float(t_out[q] - current_r[child])
                coeff_r = float(lambda_r[e] + rho_r * cr_out)
                loss += float(lambda_r[e] * cr_out + 0.5 * rho_r * cr_out**2)
                grad[t_slice.start + q] += coeff_r

                cy_out = float(y_out - y_local[child])
                coeff_y = float(lambda_y[e] + rho_y * cy_out)
                loss += float(lambda_y[e] * cy_out + 0.5 * rho_y * cy_out**2)
                grad[y_out_idx] += coeff_y

        # Same PHR physical inequality term for SQP and DON.
        g, dg = self.inequality(x_j)
        phr, dphr_dg = self.phr_value_grad_scalar(g, float(mu_g[j]), rho_g)
        loss += phr
        grad[: self.m] += dphr_dg * dg

        return float(loss), np.asarray(grad, dtype=float)

    def local_loss_torch(
        self,
        j: int,
        z: torch.Tensor,
        x_all: np.ndarray,
        y_local: np.ndarray,
        targets: np.ndarray,
        link_targets: np.ndarray,
        lambda_r: np.ndarray,
        rho_r: float,
        lambda_y: np.ndarray,
        rho_y: float,
        mu_g: np.ndarray,
        rho_g: float,
    ) -> torch.Tensor:
        cfg = self.config
        y_in_idx, t_slice, y_out_idx, _ = self._layout(j)
        x = z[: self.m]
        y_in = torch.zeros((), dtype=z.dtype, device=z.device) if y_in_idx is None else z[y_in_idx]
        t_out = z[t_slice]
        y_out = None if y_out_idx is None else z[y_out_idx]

        loss = torch.mean(phi_torch(x, cfg.kappa))
        q_local = self.local_analysis_torch(x, y_in)
        if self.children[j]:
            r_j = cfg.alpha * q_local + (1.0 - cfg.alpha) * torch.mean(t_out)
        else:
            r_j = q_local

        if j == 0:
            loss = loss + cfg.system_weight * self.N * (r_j - cfg.system_target) ** 2

        e_in = self.edge_of_child[j]
        if e_in is not None:
            cr_in = torch.as_tensor(float(targets[e_in])) - r_j
            loss = loss + float(lambda_r[e_in]) * cr_in + 0.5 * rho_r * cr_in**2

            p = self.parent[j]
            assert p is not None and y_in_idx is not None
            Y_parent = float(link_targets[self.link_target_index_of_parent[p]])
            cy_in = torch.as_tensor(Y_parent) - y_in
            loss = loss + float(lambda_y[e_in]) * cy_in + 0.5 * rho_y * cy_in**2

        if self.children[j]:
            current_r = self.responses(x_all, y_local, targets)
            assert y_out is not None
            for qidx, e in enumerate(self.out_edges[j]):
                _, child = self.edges[e]
                cr_out = t_out[qidx] - float(current_r[child])
                loss = loss + float(lambda_r[e]) * cr_out + 0.5 * rho_r * cr_out**2

                cy_out = y_out - float(y_local[child])
                loss = loss + float(lambda_y[e]) * cy_out + 0.5 * rho_y * cy_out**2

        # PHR inequality term, shared mathematically by SQP and DON.
        g = cfg.b - torch.mean(x)
        s = float(mu_g[j]) + rho_g * g
        pos = torch.relu(s)
        loss = loss + (pos**2 - float(mu_g[j]) ** 2) / (2.0 * rho_g)
        return loss

    # -------------------------------------------------------------- DON context

    def local_context(
        self,
        j: int,
        x_all: np.ndarray,
        y_local: np.ndarray,
        targets: np.ndarray,
        link_targets: np.ndarray,
        lambda_r: np.ndarray,
        rho_r: float,
        lambda_y: np.ndarray,
        rho_y: float,
        mu_g: np.ndarray,
        rho_g: float,
    ) -> np.ndarray:
        """Node context; first entries are always the current local decision z_j."""
        z = self.decision(j, x_all, y_local, targets, link_targets)
        kids = self.children[j]
        current_r = self.responses(x_all, y_local, targets)

        e_in = self.edge_of_child[j]
        if e_in is None:
            t_in = lam_r_in = Y_in = lam_y_in = 0.0
        else:
            t_in = float(targets[e_in])
            lam_r_in = float(lambda_r[e_in])
            p = self.parent[j]
            assert p is not None
            Y_in = float(link_targets[self.link_target_index_of_parent[p]])
            lam_y_in = float(lambda_y[e_in])

        child_r = np.asarray([current_r[c] for c in kids], dtype=float)
        child_y = np.asarray([y_local[c] for c in kids], dtype=float)
        lam_r_out = np.asarray([lambda_r[e] for e in self.out_edges[j]], dtype=float)
        lam_y_out = np.asarray([lambda_y[e] for e in self.out_edges[j]], dtype=float)

        meta = np.array(
            [
                t_in,
                lam_r_in,
                Y_in,
                lam_y_in,
                float(mu_g[j]),
                1.0 if j == 0 else 0.0,
                1.0 if not kids else 0.0,
                self.level[j] / max(1, self.D - 1),
                self.config.b,
                self.config.system_target,
                self.config.alpha,
                self.config.link_beta,
                math.log1p(rho_r),
                math.log1p(rho_y),
                math.log1p(rho_g),
            ],
            dtype=float,
        )
        return np.concatenate([z, child_r, child_y, lam_r_out, lam_y_out, meta])

    # ------------------------------------------------------------ initialization

    def initial_state(
        self, seed: int, scale: float = 0.25
    ) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
        rng = np.random.default_rng(seed)
        x = rng.uniform(-scale, scale, size=(self.N, self.m))
        x = np.clip(x, self.config.lower + 1e-8, self.config.upper - 1e-8)

        link_targets = rng.uniform(-scale, scale, size=self.config.N_internal)
        link_targets = np.clip(
            link_targets, self.config.lower + 1e-8, self.config.upper - 1e-8
        )
        y_local = self.consistent_link_copies(link_targets)
        targets = self.consistent_targets(x, link_targets)
        return x, y_local, targets, link_targets

    # ---------------------------------------------------------------- self test

    def check_decomposition(
        self, x_all: np.ndarray, link_targets: np.ndarray, atol: float = 1e-10
    ) -> None:
        y_local = self.consistent_link_copies(link_targets)
        targets = self.consistent_targets(x_all, link_targets)
        cr = self.response_consistency_residuals(x_all, y_local, targets)
        cy = self.link_consistency_residuals(y_local, link_targets)
        if cr.size and np.max(np.abs(cr)) > atol:
            raise AssertionError(f"response residual {np.max(np.abs(cr))}")
        if cy.size and np.max(np.abs(cy)) > atol:
            raise AssertionError(f"link residual {np.max(np.abs(cy))}")
        r_explicit = self.responses(x_all, y_local, targets)
        r_true = self.true_responses(x_all, link_targets)
        if not np.allclose(r_explicit, r_true, atol=atol, rtol=0):
            raise AssertionError("Explicit responses do not match AIO recursive responses")
        J_aio = self.global_objective(x_all, link_targets)[0]
        J_dec = self.decomposed_objective(x_all, y_local, targets)
        if not np.isclose(J_aio, J_dec, atol=atol, rtol=0):
            raise AssertionError(("objective decomposition", J_aio, J_dec))


