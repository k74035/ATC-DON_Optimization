def _solve_aio_sqp_once(
    benchmark: RegularTreeATCBenchmark,
    x0: Optional[np.ndarray] = None,
    link0: Optional[np.ndarray] = None,
    maxiter: int = 2000,
    ftol: float = 1e-12,
) -> Dict:
    """Solve the undecomposed physical problem with SLSQP as a reference."""
    cfg = benchmark.config
    if x0 is None:
        x0 = np.full((benchmark.N, benchmark.m), max(cfg.b, 0.15), dtype=float)
    else:
        x0 = np.asarray(x0, dtype=float).reshape(benchmark.N, benchmark.m).copy()
        for j in range(benchmark.N):
            deficit = cfg.b - float(np.mean(x0[j]))
            if deficit > 0:
                x0[j] += deficit + 1e-4
        x0 = np.clip(x0, cfg.lower, cfg.upper)

    if link0 is None:
        link0 = np.zeros(cfg.N_internal, dtype=float)
    else:
        link0 = np.asarray(link0, dtype=float).reshape(cfg.N_internal).copy()
    link0 = np.clip(link0, cfg.lower, cfg.upper)

    nx = benchmark.N * benchmark.m

    def unpack(flat: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        x = flat[:nx].reshape(benchmark.N, benchmark.m)
        y = flat[nx:]
        return x, y

    def fun(flat: np.ndarray) -> Tuple[float, np.ndarray]:
        x, y = unpack(flat)
        J, gx, gy, _ = benchmark.global_objective(x, y)
        return J, np.concatenate([gx.ravel(), gy])

    # scipy SLSQP uses c(x)>=0. Here c_j=mean(x_j)-b.
    def cons_fun(flat: np.ndarray) -> np.ndarray:
        x, _ = unpack(flat)
        return np.mean(x, axis=1) - cfg.b

    def cons_jac(flat: np.ndarray) -> np.ndarray:
        jac = np.zeros((benchmark.N, nx + cfg.N_internal), dtype=float)
        for j in range(benchmark.N):
            jac[j, j * benchmark.m : (j + 1) * benchmark.m] = 1.0 / benchmark.m
        return jac

    flat0 = np.concatenate([x0.ravel(), link0])
    bounds = [(cfg.lower, cfg.upper)] * flat0.size

    start = time.perf_counter()
    res = minimize(
        fun,
        flat0,
        jac=True,
        method="SLSQP",
        bounds=bounds,
        constraints=[{"type": "ineq", "fun": cons_fun, "jac": cons_jac}],
        options={"maxiter": maxiter, "ftol": ftol, "disp": False},
    )
    elapsed = time.perf_counter() - start
    x, link_targets = unpack(res.x)
    J, _, _, r0 = benchmark.global_objective(x, link_targets)
    return {
        "method": "AIO-SQP",
        "success": bool(res.success),
        "message": str(res.message),
        "x": x,
        "link_targets": link_targets,
        "objective": float(J),
        "root_response": float(r0),
        "constraint_violation": float(np.max(benchmark.constraint_violations(x))),
        "iterations": int(res.nit),
        "evaluations": int(res.nfev),
        "time": float(elapsed),
    }


