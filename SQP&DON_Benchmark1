def finite_difference_gradient(fun, z: np.ndarray, h: float = 1e-6) -> np.ndarray:
    out = np.zeros_like(z, dtype=float)
    for i in range(z.size):
        zp = z.copy(); zp[i] += h
        zm = z.copy(); zm[i] -= h
        out[i] = (fun(zp) - fun(zm)) / (2.0 * h)
    return out


def revision_self_test():
    import sys
    a=sys.modules[__name__]
    import numpy as np
    import torch
    c=a.BenchmarkConfig(); b=a.RegularTreeATCBenchmark(c)
    assert (c.n_local_design_total,c.n_design_total,c.n_decomposed_primal_total)==(56,59,71)
    for v in [c.lower,c.upper]:
     x=np.full((b.N,b.m),v); Y=np.full(c.N_internal,v)
     y=b.consistent_link_copies(Y); t=b.consistent_targets(x,Y)
     b.check_decomposition(x,Y)
     for j in range(b.N):
      z=b.decision(j,x,y,t,Y); lo,hi=b.decision_bounds(j)
      assert np.all(z>=lo-1e-12) and np.all(z<=hi+1e-12)
    x,y,t,Y=b.initial_state(3,.25)
    lr=np.ones(c.N_edge)*.2;ly=lr.copy();mu=np.ones(b.N)*.3
    for j in [0,1,6]:
     z=b.decision(j,x,y,t,Y)
     args=(j,z,x,y,t,Y,lr,5.,ly,5.,mu,5.)
     val,g=b.local_loss_grad(*args)
     zz=torch.tensor(z,requires_grad=True)
     vv=b.local_loss_torch(j,zz,*args[2:]);vv.backward()
     assert np.allclose(vv.item(),val) and np.allclose(zz.grad.numpy(),g)
    model=a.build_don_models(b,x,y,t,Y,lr,ly,mu,a.SolverSettings(),0)[0]
    z,info=a.solve_local_don(b,0,model,x,y,t,Y,lr,5.,ly,5.,mu,5.,1,.001,1,1e-12)
    assert not info['success']
    print('counts, feasible response bounds, root/internal/leaf torch gradients, failure flag: PASS')


def self_test() -> None:
    revision_self_test()
    rng = np.random.default_rng(123)
    for B, D, kappa in [(2, 2, "Q2"), (2, 3, "Q4"), (3, 3, "EXP")]:
        config = BenchmarkConfig(m=4, B=B, D=D, kappa=kappa)
        bm = RegularTreeATCBenchmark(config)
        x = rng.uniform(-0.5, 0.8, size=(bm.N, bm.m))
        Y = rng.uniform(-0.4, 0.4, size=config.N_internal)
        bm.check_decomposition(x, Y)

        # AIO analytic gradient check wrt both x and physical shared links Y.
        nx = bm.N * bm.m
        flat = np.concatenate([x.ravel(), Y])

        def aio_fun(v: np.ndarray) -> float:
            xx = v[:nx].reshape(bm.N, bm.m)
            yy = v[nx:]
            return bm.global_objective(xx, yy)[0]

        J, gx, gy, _ = bm.global_objective(x, Y)
        analytic = np.concatenate([gx.ravel(), gy])
        fd = finite_difference_gradient(aio_fun, flat)
        err = float(np.max(np.abs(fd - analytic)))
        if err > 4e-5:
            raise AssertionError(("AIO gradient", B, D, kappa, err, J))

        # Local AL gradient check, including linking-variable consistency.
        y_local = bm.consistent_link_copies(Y)
        targets = bm.consistent_targets(x, Y)
        lambda_r = rng.normal(scale=0.2, size=config.N_edge)
        lambda_y = rng.normal(scale=0.2, size=config.N_edge)
        mu_g = np.abs(rng.normal(scale=0.2, size=bm.N))
        j = 1 if bm.N > 1 else 0
        z = bm.decision(j, x, y_local, targets, Y)
        val, g = bm.local_loss_grad(
            j, z, x, y_local, targets, Y,
            lambda_r, 3.0, lambda_y, 2.5, mu_g, 4.0
        )
        fdg = finite_difference_gradient(
            lambda zz: bm.local_loss_grad(
                j, zz, x, y_local, targets, Y,
                lambda_r, 3.0, lambda_y, 2.5, mu_g, 4.0
            )[0],
            z,
        )
        err2 = float(np.max(np.abs(fdg - g)))
        if err2 > 6e-5:
            raise AssertionError(("local gradient", B, D, kappa, err2, val))

    print(
        "SELF-TEST PASSED: B-ary tree, nonlinear response model, shared sibling "
        "linking variables, response/link consistency, exact AIO decomposition, "
        "and analytic gradients."
    )


