def parse_int_list(text: str) -> List[int]:
    return [int(v.strip()) for v in text.split(",") if v.strip()]


def make_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
        description=(
            "Controlled ATC-SQP vs ATC-DON benchmark with target-response and "
            "shared linking-variable coordination."
        ),
    )
    p.add_argument(
        "--case",
        default="1A",
        choices=[
            "1A", "1B", "1C", "1D", "1E",
            "2A", "2B", "2C", "2D", "2E", "2F",
            "case1", "case2", "all",
        ],
    )
    p.add_argument("--seeds", default="1", help="comma-separated design initialization seeds")
    p.add_argument("--nn-seeds", default="1", help="comma-separated DON weight seeds")
    p.add_argument("--methods", default="sqp,don", help="comma-separated subset of sqp,don")
    p.add_argument("--no-aio", action="store_true", help="do not write AIO reference rows")
    p.add_argument("--output", default="atc_benchmark_final_results.csv")
    p.add_argument("--limit-configs", type=int, default=0, help="debug: keep only first N configs/sweep values")
    p.add_argument("--self-test", action="store_true")
    p.add_argument("--self-test-only", action="store_true")

    # Shared ATC settings.
    p.add_argument("--rho-r", type=float, default=5.0, help="response-consistency AL penalty")
    p.add_argument("--rho-y", type=float, default=5.0, help="linking-consistency AL penalty")
    p.add_argument("--rho-g", type=float, default=5.0, help="PHR inequality penalty")
    p.add_argument("--tol", type=float, default=1e-3, help="ATC outer epsilon")
    p.add_argument("--max-outer", type=int, default=100)
    p.add_argument("--inner-sweeps", type=int, default=1)
    p.add_argument("--sweep-order", choices=["topdown", "bottomup"], default="topdown")
    p.add_argument("--init-scale", type=float, default=0.25)

    # Backward-compatible alias for the old response-consistency penalty name.
    p.add_argument("--rho-c", type=float, default=None, help=argparse.SUPPRESS)

    # SQP local solver.
    p.add_argument("--sqp-maxiter", type=int, default=250)
    p.add_argument("--sqp-ftol", type=float, default=1e-12)

    # DON baseline settings; CASE2 changes one at a time around these values.
    p.add_argument("--don-width", type=int, default=32)
    p.add_argument("--don-layers", type=int, default=2)
    p.add_argument("--don-activation", choices=["tanh", "relu", "silu"], default="tanh")
    p.add_argument("--don-epochs", type=int, default=300)
    p.add_argument("--don-lr", type=float, default=1e-3)
    p.add_argument("--don-check-every", type=int, default=20)
    p.add_argument("--don-inner-tol", type=float, default=1e-4)
    p.add_argument("--don-warm-start", dest="don_warm_start", action="store_true")
    p.add_argument("--no-don-warm-start", dest="don_warm_start", action="store_false")
    p.set_defaults(don_warm_start=True)
    return p


def settings_from_args(args: argparse.Namespace) -> SolverSettings:
    rho_r = args.rho_r if args.rho_c is None else args.rho_c
    return SolverSettings(
        rho_r=rho_r,
        rho_y=args.rho_y,
        rho_g=args.rho_g,
        tol=args.tol,
        max_outer=args.max_outer,
        inner_sweeps=args.inner_sweeps,
        sweep_order=args.sweep_order,
        sqp_maxiter=args.sqp_maxiter,
        sqp_ftol=args.sqp_ftol,
        don_width=args.don_width,
        don_layers=args.don_layers,
        don_activation=args.don_activation,
        don_epochs=args.don_epochs,
        don_lr=args.don_lr,
        don_check_every=args.don_check_every,
        don_inner_tol=args.don_inner_tol,
        don_warm_start=args.don_warm_start,
        init_scale=args.init_scale,
    )


def selected_case_names(case_arg: str) -> Tuple[List[str], List[str]]:
    c1: List[str] = []
    c2: List[str] = []
    if case_arg in CASE1_DEFINITIONS:
        c1 = [case_arg]
    elif case_arg in CASE2_SWEEPS:
        c2 = [case_arg]
    elif case_arg == "case1":
        c1 = list(CASE1_DEFINITIONS)
    elif case_arg == "case2":
        c2 = list(CASE2_SWEEPS)
    elif case_arg == "all":
        c1 = list(CASE1_DEFINITIONS)
        c2 = list(CASE2_SWEEPS)
    return c1, c2


def main() -> None:
    parser = make_parser()
    args = parser.parse_args()

    if args.self_test or args.self_test_only:
        self_test()
        if args.self_test_only:
            return

    seeds = parse_int_list(args.seeds)
    nn_seeds = parse_int_list(args.nn_seeds)
    if not seeds:
        raise ValueError("At least one --seeds value is required")
    if not nn_seeds:
        raise ValueError("At least one --nn-seeds value is required")

    methods = [m.strip().lower() for m in args.methods.split(",") if m.strip()]
    if any(m not in {"sqp", "don"} for m in methods):
        raise ValueError("--methods must contain only sqp and/or don")

    base_settings = settings_from_args(args)
    case1_names, case2_names = selected_case_names(args.case)
    rows: List[Dict] = []

    for case_name in case1_names:
        definition = CASE1_DEFINITIONS[case_name]
        configs = list(definition["configs"])
        if args.limit_configs > 0:
            configs = configs[: args.limit_configs]
        print(f"\n=== {case_name}: {definition['description']} ===")
        for config in configs:
            rows.extend(
                run_one_config(
                    case_name,
                    config,
                    copy.deepcopy(base_settings),
                    seeds,
                    nn_seeds,
                    methods,
                    include_aio=not args.no_aio,
                )
            )

    for case_name in case2_names:
        field, values = CASE2_SWEEPS[case_name]
        values = list(values)
        if args.limit_configs > 0:
            values = values[: args.limit_configs]
        print(f"\n=== {case_name}: DON sensitivity of {field} ===")

        for value in values:
            s = copy.deepcopy(base_settings)
            setattr(s, field, value)
            rows.extend(
                run_one_config(
                    case_name,
                    CASE2_CONFIG,
                    s,
                    seeds,
                    nn_seeds,
                    methods,
                    include_aio=not args.no_aio,
                    variant_name=field,
                    variant_value=value,
                )
            )

    output = Path(args.output)
    write_rows(rows, output)
    save_metadata(output, args, base_settings)
    print(f"\nSaved {len(rows)} rows -> {output.resolve()}")
    print(f"Metadata -> {output.with_suffix('.json').resolve()}")


if __name__ == "__main__":
    main()
