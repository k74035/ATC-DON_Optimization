def run_one_config(
    case_name: str,
    config: BenchmarkConfig,
    settings: SolverSettings,
    seeds: Sequence[int],
    nn_seeds: Sequence[int],
    methods: Sequence[str],
    include_aio: bool,
    variant_name: str = "",
    variant_value: object = "",
) -> List[Dict]:
    benchmark = RegularTreeATCBenchmark(config)
    ref = solve_aio_sqp(benchmark)
    if not ref["success"]:
        print(f"WARNING: AIO reference did not report success: {ref['message']}")

    rows: List[Dict] = []
    if include_aio:
        ar = aio_row(case_name, config, settings, ref)
        ar["variant_name"] = variant_name
        ar["variant_value"] = variant_value
        rows.append(ar)

    for seed in seeds:
        if "sqp" in methods:
            res = solve_atc(
                benchmark,
                method="SQP",
                seed=seed,
                nn_seed=-1,
                settings=settings,
                reference=ref,
            )
            rows.append(
                result_row(case_name, config, settings, res, variant_name, variant_value)
            )
            print(
                f"[{case_name}] {config.short_label()} seed={seed} ATC-SQP "
                f"ok={res['success']} Jerr={res['objective_error']:.3e} "
                f"cR={res['response_consistency']:.2e} "
                f"cY={res['link_consistency']:.2e} "
                f"g={res['constraint_violation']:.2e} t={res['time']:.3f}s"
            )

        if "don" in methods:
            for nn_seed in nn_seeds:
                res = solve_atc(
                    benchmark,
                    method="DON",
                    seed=seed,
                    nn_seed=nn_seed,
                    settings=settings,
                    reference=ref,
                )
                rows.append(
                    result_row(
                        case_name, config, settings, res, variant_name, variant_value
                    )
                )
                print(
                    f"[{case_name}] {config.short_label()} seed={seed} nn={nn_seed} "
                    f"ATC-DON ok={res['success']} Jerr={res['objective_error']:.3e} "
                    f"cR={res['response_consistency']:.2e} "
                    f"cY={res['link_consistency']:.2e} "
                    f"g={res['constraint_violation']:.2e} t={res['time']:.3f}s"
                )

    return rows


def write_rows(rows: List[Dict], output_csv: Path) -> None:
    output_csv.parent.mkdir(parents=True, exist_ok=True)
    if not rows:
        return
    keys: List[str] = []
    seen = set()
    for row in rows:
        for k in row.keys():
            if k not in seen:
                keys.append(k)
                seen.add(k)
    with output_csv.open("w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=keys)
        writer.writeheader()
        writer.writerows(rows)


