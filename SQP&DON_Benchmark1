def solve_aio_sqp(benchmark, x0=None, link0=None, maxiter=2000, ftol=1e-12):
    """Three-start numerical reference; explicit initial conditions use one start.

    Report total search time/evaluations, never the best run's time alone.
    A successful SLSQP exit does not certify global optimality.
    """
    runs = [_solve_aio_sqp_once(benchmark, x0, link0, maxiter, ftol)]
    if x0 is None and link0 is None:
        for seed in (17, 41):
            xx, _, _, yy = benchmark.initial_state(seed, 0.75)
            runs.append(_solve_aio_sqp_once(benchmark, xx, yy, maxiter, ftol))
    candidates = [r for r in runs if r['success'] and r['constraint_violation'] <= 1e-6]
    best = dict(min(candidates or runs, key=lambda r: r['objective']))
    best['success'] = bool(candidates)
    best['time'] = sum(r['time'] for r in runs)
    best['evaluations'] = sum(r['evaluations'] for r in runs)
    best['iterations'] = sum(r['iterations'] for r in runs)
    best['reference_starts'] = len(runs)
    return best


def projected_grad_inf(
    z: np.ndarray, grad: np.ndarray, lower: float, upper: float, atol: float = 1e-9
) -> float:
    # Unit-step projected gradient mapping, valid for scalar or vector bounds.
    return float(np.max(np.abs(z - np.clip(z - grad, lower, upper))))



def solve_local_sqp(
    benchmark: RegularTreeATCBenchmark,
    j: int,
    x_all: np.ndarray,
    y_local: np.ndarray,
    targets: np.ndarray,
    link_targets: np.ndarray,
    lambda_r: np.ndarray,
    rho_r: float,
    lambda_y: np.ndarray,
    rho_y: float,
    mu_g: np.ndarray,
    rho_g: float,
    maxiter: int,
    ftol: float,
    inner_tol: float = 1e-4,
) -> Tuple[np.ndarray, Dict]:
    z0 = benchmark.decision(j, x_all, y_local, targets, link_targets)

    def fun(z: np.ndarray) -> Tuple[float, np.ndarray]:
        return benchmark.local_loss_grad(
            j,
            z,
            x_all,
            y_local,
            targets,
            link_targets,
            lambda_r,
            rho_r,
            lambda_y,
            rho_y,
            mu_g,
            rho_g,
        )

    res = minimize(
        fun,
        z0,
        jac=True,
        method="SLSQP",
        bounds=list(zip(*benchmark.decision_bounds(j))),
        options={"maxiter": maxiter, "ftol": ftol, "disp": False},
    )
    _, grad = fun(res.x)
    stationarity = projected_grad_inf(
        res.x, grad, *benchmark.decision_bounds(j)
    )
    return np.asarray(res.x, dtype=float), {
        "iterations": int(res.nit),
        "evaluations": int(res.nfev) + 1,
        "stationarity": stationarity,
        "success": bool(np.isfinite(stationarity) and stationarity <= inner_tol),
    }


class LocalDON(nn.Module):
    """Node-specific online Deep Optimizer Network."""

    def __init__(
        self,
        input_dim: int,
        output_dim: int,
        width: int,
        layers: int,
        activation: str,
        lower: float,
        upper: float,
        seed: int,
    ) -> None:
        super().__init__()
        if width < 1 or layers < 1:
            raise ValueError("DON width and layers must be >=1")
        self.input_dim = int(input_dim)
        self.output_dim = int(output_dim)
        self.lower = torch.as_tensor(lower, dtype=torch.float64)
        self.upper = torch.as_tensor(upper, dtype=torch.float64)
        self.activation_name = activation.lower()
        self.seed = int(seed)
        torch.manual_seed(self.seed)

        def act() -> nn.Module:
            if self.activation_name == "tanh":
                return nn.Tanh()
            if self.activation_name == "relu":
                return nn.ReLU()
            if self.activation_name == "silu":
                return nn.SiLU()
            raise ValueError(f"Unsupported DON activation: {activation}")

        modules: List[nn.Module] = []
        in_features = self.input_dim
        for _ in range(layers):
            modules += [nn.Linear(in_features, width), act()]
            in_features = width
        modules.append(nn.Linear(in_features, self.output_dim))
        self.net = nn.Sequential(*modules).double()

        # Zero correction initially => current local decision is returned.
        with torch.no_grad():
            last = self.net[-1]
            assert isinstance(last, nn.Linear)
            last.weight.zero_()
            last.bias.zero_()

        self._initial_state = {
            key: value.detach().clone() for key, value in self.state_dict().items()
        }

    def reset_to_initial(self) -> None:
        self.load_state_dict(self._initial_state)

    def forward(self, context: torch.Tensor) -> torch.Tensor:
        current = context[: self.output_dim]
        # Exact feasible baseline, with per-call recentering in solve_local_don.
        return torch.maximum(self.lower, torch.minimum(self.upper, current + self.net(context)))



def solve_local_don(
    benchmark: RegularTreeATCBenchmark,
    j: int,
    model: LocalDON,
    x_all: np.ndarray,
    y_local: np.ndarray,
    targets: np.ndarray,
    link_targets: np.ndarray,
    lambda_r: np.ndarray,
    rho_r: float,
    lambda_y: np.ndarray,
    rho_y: float,
    mu_g: np.ndarray,
    rho_g: float,
    epochs: int,
    lr: float,
    check_every: int,
    inner_tol: float,
) -> Tuple[np.ndarray, Dict]:
    context_np = benchmark.local_context(
        j,
        x_all,
        y_local,
        targets,
        link_targets,
        lambda_r,
        rho_r,
        lambda_y,
        rho_y,
        mu_g,
        rho_g,
    )
    context = torch.as_tensor(context_np, dtype=torch.float64)
    # Preserve learned features but remove the old correction at the new context.
    # Adam state is deliberately reset because this recentering changes the bias.
    with torch.no_grad():
        model.net[-1].bias.sub_(model.net(context))
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)

    def assess():
        with torch.no_grad():
            zz = model(context).cpu().numpy()
        vv, gg = benchmark.local_loss_grad(j, zz, x_all, y_local, targets,
            link_targets, lambda_r, rho_r, lambda_y, rho_y, mu_g, rho_g)
        return vv, projected_grad_inf(zz, gg, *benchmark.decision_bounds(j))
    best_loss, stationarity = assess()
    best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}
    evaluations = 1
    used = 0
    if stationarity <= inner_tol:
        return model(context).detach().numpy(), dict(iterations=0,
            evaluations=1, stationarity=stationarity, success=True)
    for epoch in range(epochs):
        optimizer.zero_grad(set_to_none=True)
        z = model(context)
        loss = benchmark.local_loss_torch(
            j,
            z,
            x_all,
            y_local,
            targets,
            link_targets,
            lambda_r,
            rho_r,
            lambda_y,
            rho_y,
            mu_g,
            rho_g,
        )
        loss.backward()
        optimizer.step()
        used = epoch + 1
        evaluations += 1

        if used % check_every == 0 or used == epochs:
            with torch.no_grad():
                z_np = model(context).cpu().numpy()
            _, grad = benchmark.local_loss_grad(
                j,
                z_np,
                x_all,
                y_local,
                targets,
                link_targets,
                lambda_r,
                rho_r,
                lambda_y,
                rho_y,
                mu_g,
                rho_g,
            )
            stationarity = projected_grad_inf(
                z_np, grad, *benchmark.decision_bounds(j)
            )
            value, stationarity = assess()
            evaluations += 2
            if np.isfinite(value) and value < best_loss:
                best_loss = value
                best_state = {k: v.detach().clone() for k,v in model.state_dict().items()}
            if stationarity <= inner_tol:
                best_state = {k: v.detach().clone() for k,v in model.state_dict().items()}

                break

    model.load_state_dict(best_state)
    with torch.no_grad():
        z_final = model(context).cpu().numpy()
    _, grad = benchmark.local_loss_grad(
        j,
        z_final,
        x_all,
        y_local,
        targets,
        link_targets,
        lambda_r,
        rho_r,
        lambda_y,
        rho_y,
        mu_g,
        rho_g,
    )
    stationarity = projected_grad_inf(
        z_final, grad, *benchmark.decision_bounds(j)
    )
    return np.asarray(z_final, dtype=float), {
        "iterations": int(used),  # epochs, not directly comparable to SQP iterations
        "evaluations": int(evaluations) + 1,
        "stationarity": stationarity,
        "success": bool(np.isfinite(stationarity) and stationarity <= inner_tol),
    }


